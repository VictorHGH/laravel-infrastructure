# Copy this file values into Dokploy environment variables.
# Do NOT commit real secrets.

PROJECT_NAME=miapp
APP_NAME="Laravel App"
UID=1000
GID=1000

MYSQL_IMAGE_TAG=8.0.36
PHP_BASE_IMAGE=php:8.4-fpm-alpine
NGINX_BASE_IMAGE=nginx:1.26.2-alpine
COMPOSER_IMAGE_TAG=2.7.7
XDEBUG_VERSION=3.5.0
REDIS_PECL_VERSION=6.1.0

APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REEMPLAZAR_APP_KEY
APP_URL=https://tu-dominio.com
LOG_CHANNEL=stack
LOG_LEVEL=warning

MYSQL_DATABASE=laravel_project
MYSQL_USER=laravel_user
MYSQL_PASSWORD=REEMPLAZAR_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REEMPLAZAR_DB_ROOT_PASSWORD

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=usuario_smtp
MAIL_PASSWORD=REEMPLAZAR_MAIL_PASSWORD
MAIL_FROM_ADDRESS=no-reply@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"
